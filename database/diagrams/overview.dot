decision__manual_review_cases -> decision__manual_review_actions [style=dashed, color="#7c3aed", constraint=false];
decision__manual_review_cases -> decision__assessments [style=solid, color="#64748b"];
decision__manual_review_cases -> decision__decisions [style=solid, color="#64748b"];
decision__offers -> decision__decisions [style=dashed, color="#7c3aed"];
}

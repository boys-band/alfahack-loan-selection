digraph ER {
graph [rankdir=LR, bgcolor="#ffffff", fontname="DejaVu Sans", fontsize=22, pad="0.35", nodesep="0.4", ranksep="0.8", splines=polyline, outputorder=edgesfirst, labelloc=t, label="ER-модель · шесть независимых баз данных\nСтрелки: дочерняя таблица → родительская. Пунктир: отложенный FK. Межбазовых FK нет.", size="32,28", dpi=120];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [color="#64748b", arrowsize=0.7, fontname="DejaVu Sans", fontsize=10];
subgraph cluster_applications {
label="alfa_applications · Заявки и процесс"; color="#2563eb"; style="rounded"; bgcolor="#eff6ff"; fontsize=18; margin=20;
applications__application_data_versions [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#2563eb"><TR><TD BGCOLOR="#eff6ff"><B>application_data_versions</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK: application_id, data_version</FONT></TD></TR></TABLE>>];

decision__manual_review_cases [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#7c3aed"><TR><TD BGCOLOR="#f5f3ff"><B>manual_review_cases</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK: id</FONT></TD></TR></TABLE>>];
decision__offers [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#7c3aed"><TR><TD BGCOLOR="#f5f3ff"><B>offers</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK: id</FONT></TD></TR></TABLE>>];
decision__decisions -> decision__offers [style=dashed, color="#7c3aed", constraint=false];
decision__decisions -> decision__assessments [style=solid, color="#64748b"];

decision__evaluated_terms -> decision__assessments [style=solid, color="#64748b"];
decision__manual_review_actions -> decision__manual_review_cases [style=solid, color="#64748b", label="2 FK"];
decision__manual_review_actions -> decision__decisions [style=dashed, color="#7c3aed"];

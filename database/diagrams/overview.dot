applications__idempotency_records [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#2563eb"><TR><TD BGCOLOR="#eff6ff"><B>idempotency_records</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK: caller, method, path, idempotency_key</FONT></TD></TR></TABLE>>];
applications__information_requests [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#2563eb"><TR><TD BGCOLOR="#eff6ff"><B>information_requests</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK: id</FONT></TD></TR></TABLE>>];
applications__offer_acceptances [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#2563eb"><TR><TD BGCOLOR="#eff6ff"><B>offer_acceptances</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK: id</FONT></TD></TR></TABLE>>];
applications__payout_instructions [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#2563eb"><TR><TD BGCOLOR="#eff6ff"><B>payout_instructions</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK: application_id, data_version, payout_version</FONT></TD></TR></TABLE>>];
applications__workflow_attempts [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#2563eb"><TR><TD BGCOLOR="#eff6ff"><B>workflow_attempts</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK: id</FONT></TD></TR></TABLE>>];
applications__workflow_jobs [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#2563eb"><TR><TD BGCOLOR="#eff6ff"><B>workflow_jobs</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK: id</FONT></TD></TR></TABLE>>];
applications__application_data_versions -> applications__applications [style=dashed, color="#2563eb"];
applications__application_timeline -> applications__applications [style=solid, color="#64748b"];
applications__applications -> applications__offer_acceptances [style=dashed, color="#2563eb", constraint=false];
applications__applications -> applications__application_data_versions [style=dashed, color="#2563eb", constraint=false];
applications__applications -> applications__information_requests [style=dashed, color="#2563eb", constraint=false];
applications__applications -> applications__workflow_jobs [style=dashed, color="#2563eb", constraint=false];
applications__applications -> applications__payout_instructions [style=dashed, color="#2563eb", constraint=false];
applications__applications -> applications__customer_companies [style=solid, color="#64748b", constraint=false];
applications__customer_companies -> applications__companies [style=solid, color="#64748b"];
applications__information_requests -> applications__application_data_versions [style=solid, color="#64748b"];
applications__offer_acceptances -> applications__application_data_versions [style=solid, color="#64748b"];
applications__payout_instructions -> applications__application_data_versions [style=solid, color="#64748b"];
applications__workflow_attempts -> applications__workflow_jobs [style=solid, color="#64748b"];
applications__workflow_jobs -> applications__application_data_versions [style=solid, color="#64748b"];
applications__workflow_jobs -> applications__applications [style=solid, color="#64748b"];
}

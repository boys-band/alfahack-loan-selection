disbursement__disbursements [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#047857"><TR><TD BGCOLOR="#ecfdf5"><B>disbursements</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK: id</FONT></TD></TR></TABLE>>];
disbursement__idempotency_records [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#047857"><TR><TD BGCOLOR="#ecfdf5"><B>idempotency_records</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK: caller, method, path, idempotency_key</FONT></TD></TR></TABLE>>];

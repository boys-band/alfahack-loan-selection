}
subgraph cluster_decision {
label="alfa_decision · Скоринг и решения"; color="#7c3aed"; style="rounded"; bgcolor="#f5f3ff"; fontsize=18; margin=20;
decision__assessments [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#7c3aed"><TR><TD BGCOLOR="#f5f3ff"><B>assessments</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK: id</FONT></TD></TR></TABLE>>];
decision__decisions [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#7c3aed"><TR><TD BGCOLOR="#f5f3ff"><B>decisions</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK: id</FONT></TD></TR></TABLE>>];
decision__evaluated_terms [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#7c3aed"><TR><TD BGCOLOR="#f5f3ff"><B>evaluated_terms</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK: id</FONT></TD></TR></TABLE>>];
decision__idempotency_records [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#7c3aed"><TR><TD BGCOLOR="#f5f3ff"><B>idempotency_records</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK: caller, method, path, idempotency_key</FONT></TD></TR></TABLE>>];

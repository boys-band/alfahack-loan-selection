digraph ER {
graph [rankdir=LR, bgcolor="#ffffff", fontname="DejaVu Sans", fontsize=22, pad="0.35", nodesep="0.4", ranksep="0.8", splines=polyline, outputorder=edgesfirst, labelloc=t, label="ER · disbursement · Выдача и проводки\nPK — первичный ключ · FK — внешний ключ · UQ — участие в UNIQUE · ? — NULL · [G] — вычисляемое поле", size="32,28", dpi=120];

{
  "name": "alfa-credit-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.22.1"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test-e2e": "playwright test",
    "start": "node server.mjs",
    "contracts": "python3 scripts/sync-contracts.py",
    "test-e2e:real": "playwright test --config playwright.real.config.ts"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "msw": "2.11.6",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.9.4"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.18.11",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "jsdom": "27.0.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "3.2.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
